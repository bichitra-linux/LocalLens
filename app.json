{
  "expo": {
    "name": "LocalLens",
    "slug": "locallens-app",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "np.com.bichitra.locallens",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LocalLens needs location access to show nearby notes and create location-based content.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "LocalLens needs location access to provide location-based features and notifications about nearby notes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2196F3"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "package": "np.com.bichitra.locallens",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
  "plugins": [
    "expo-location",
    "@maplibre/maplibre-react-native",
    [
      "expo-build-properties",
      {
        "ios": {
          "useFrameworks": "static"
        }
      }
    ],
    "react-native-google-mobile-ads"
  ],
    "extra": {
      "eas": {
        "projectId": "9d01c23d-3b84-4802-8d8f-27a708860e62"
      }
    },
    "owner": "bichitra"
  }
}
